# CognoDB Cloud connection details (console.cognodb.com)
# Copy this file to .env and fill in the values shown once when you created your instance.
# NEVER commit the real .env file.

NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=<your-generated-password>

PORT=4000
CORS_ORIGIN=http://localhost:5173
